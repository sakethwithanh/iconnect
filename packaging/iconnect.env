# iconnect runtime configuration.
# Edit and either restart services (`iconnect stop && iconnect start`) or
# re-run `iconnect run`.

# AirPlay advertised name
ICONNECT_NAME=iconnect

# uxplay sink overrides
#ICONNECT_RES=1920x1080
#ICONNECT_FPS=60

# Touchpad sensitivity multiplier (lower = slower cursor)
ICONNECT_TP_SCALE=0.3

# Lock /tmp/iconnect-hid.sock to this user (0600). Required when btkbd runs
# as a systemd system service (no SUDO_USER available).
ICONNECT_USER=saketh

# Auto-hide the adapter from BT scans after this many seconds. Paired iPhone
# still reconnects since it has the LTK. Set 0 to keep discoverable forever.
ICONNECT_DISCOVERABLE_SECS=180

# iPhone Bluetooth MAC for outbound auto-reconnect. Leave blank to auto-discover.
#ICONNECT_IPHONE_MAC=

# Verbose tx/rx logging. Set to "0" to silence per-event logs once stable.
ICONNECT_DEBUG=1
